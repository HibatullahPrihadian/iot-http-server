{
  "name": "iot-http-server",
  "private": true,
  "version": "2.2.1",
  "description": "Sistem monitoring IoT + plan tanam hidroponik (iot-api, hidro-backend, web)",
  "scripts": {
    "setup": "node scripts/install-hooks.mjs",
    "version:read": "node scripts/version.mjs",
    "version:bump": "node scripts/version.mjs --bump",
    "version:check": "node scripts/check-version.mjs",
    "build:web": "npm --prefix web run build",
    "test:hidro": "node hidro-backend/hsscheck.js",
    "test:settings": "node hidro-backend/settingscheck.js"
  },
  "engines": {
    "node": ">=20.19"
  }
}
