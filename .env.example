# Origin yang diizinkan CORS, dipisah koma. Kosong = tanpa CORS (UI satu origin via nginx).
# WAJIB sertakan skema (http:// atau https://) dan tanpa slash di akhir.
# Contoh banyak origin:
#   CORS_ORIGIN=http://localhost:3000,http://192.168.1.10:3000
CORS_ORIGIN=
# Port host untuk frontend gabungan (default 5005).
FRONTEND_PORT=5005
# Token statis untuk endpoint perangkat (X-Device-Token).
# Harus SAMA dengan DEVICE_TOKEN di firmware ESP32 dan dipakai Node-RED + iot-api.
# Buat dengan nilai acak panjang, mis:
#   openssl rand -hex 32
DEVICE_TOKEN=
# Token named Cloudflare Tunnel untuk iot.phd.my.id -> web:80.
# Kosong = fallback ke quick tunnel (hostname acak, tidak cocok untuk ESP32).
TUNNEL_TOKEN=

# --- InfluxDB ---
# Kredensial setup InfluxDB (dipakai saat init volume pertama kali).
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=
INFLUXDB_ORG=hidroponik
INFLUXDB_BUCKET=sensor_data
# URL + token untuk iot-api membaca InfluxDB. URL default mengarah ke service compose.
INFLUXDB_URL=http://influxdb:8086
# Token API InfluxDB (bukan password admin). Ambil dari UI InfluxDB -> API Tokens.
INFLUXDB_TOKEN=

# --- Sensor IoT (panel tangki, hidro-backend) ---
# URL API data sensor. Host HARUS hidroponik.phd.my.id (phd.my.id tidak resolve).
IOT_API_URL=https://hidroponik.phd.my.id/api/sensor-data?filter=realtime
# Token opsional; kosong = tanpa header auth (endpoint sensor saat ini terbuka).
IOT_API_KEY=
# Timeout request sensor (ms).
IOT_TIMEOUT_MS=5000
